CONTENT_API_BASE=https://api.raven.kr
CONTENT_SOURCE=mock
REVALIDATE_SECRET=change-me
# Supabase Postgres/Auth (the publishable key may be a legacy anon key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only. Required for the comments API; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_INTERNAL_URL=http://raven-supabase-dev-rest:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
# GA4 Measurement ID. Local development leaves analytics disabled.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# GA4 Data API (server only). The service account needs Viewer access to this property.
GA4_PROPERTY_ID=461865918
GA4_CLIENT_EMAIL=analytics-reader@example.iam.gserviceaccount.com
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Or set GOOGLE_APPLICATION_CREDENTIALS to an absolute service-account JSON path.
GA4_HOSTNAME=raven.kr
CMS_OWNER_EMAILS=owner@example.com
SITE_URL=http://localhost:3500

# Image storage. Omit ASSET_STORAGE_BACKEND to keep the production R2 backend.
ASSET_STORAGE_BACKEND=r2
ASSET_PUBLIC_URL=https://cdn.raven.kr
# Dev only: use local with SITE_URL=https://dev.raven.kr and an app-writable shared mount.
# ASSET_STORAGE_BACKEND=local
# ASSET_LOCAL_ROOT=/srv/assets
# ASSET_PUBLIC_URL=https://cdn-dev.raven.kr

# Cloudflare R2 S3 API and public custom domain
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=blog-assets
R2_PUBLIC_URL=https://cdn.raven.kr
