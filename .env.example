CONTENT_API_BASE=https://api.raven.kr
CONTENT_SOURCE=mock
REVALIDATE_SECRET=change-me
# Supabase Postgres/Auth (the publishable key may be a legacy anon key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
CMS_OWNER_EMAILS=owner@example.com
SITE_URL=http://localhost:3500

# Cloudflare R2 S3 API and public custom domain
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=blog-assets
R2_PUBLIC_URL=https://cdn.raven.kr
