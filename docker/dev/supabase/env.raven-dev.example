# Add these entries to the private upstream docker/.env after generating its secrets.
# The hostname is a proposal until the existing tunnel configuration is inspected.
SUPABASE_PUBLIC_URL=https://supabase-dev.raven.kr
API_EXTERNAL_URL=https://supabase-dev.raven.kr/auth/v1
SITE_URL=https://dev.raven.kr
ADDITIONAL_REDIRECT_URLS=https://dev.raven.kr/auth/callback

GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=replace_with_raven_dev_google_client_id
GOOGLE_SECRET=replace_with_raven_dev_google_client_secret
