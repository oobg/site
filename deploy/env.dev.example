NODE_ENV=production
CONTENT_SOURCE=supabase
SITE_URL=https://dev.raven.kr
SITE_INDEXABLE=false

NEXT_PUBLIC_SUPABASE_URL=https://supabase-dev.raven.kr
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_raven_dev_publishable_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_raven_dev_service_role_key
SUPABASE_INTERNAL_URL=http://raven-supabase-dev-rest:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace_with_raven_dev_google_client_id
CMS_OWNER_EMAILS=replace_with_raven_dev_owner_email

# Runtime secrets: dev admin API Access app's HTTPS team origin and AUD.
# Set both or leave both blank to disable Access automation.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUDIENCE=
# Docs access is production-only and intentionally has no dev AUD value.

ASSET_STORAGE_BACKEND=local
ASSET_LOCAL_ROOT=/srv/assets
ASSET_PUBLIC_URL=https://cdn-dev.raven.kr
