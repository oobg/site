# Copy to ~/raven-production/config/.env.production and chmod 600.
# This file is both the Compose interpolation source and the web runtime env.
# NEXT_PUBLIC_* values are public and become part of the browser bundle.
# Leave secrets blank in this repository template.

NODE_ENV=production
CONTENT_SOURCE=supabase
CONTENT_API_BASE=https://api.raven.kr
SITE_URL=https://raven.kr
SITE_INDEXABLE=true
ASSET_STORAGE_BACKEND=r2

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
CMS_OWNER_EMAILS=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://cdn.raven.kr

# Only needed while the legacy content API sends revalidation webhooks.
REVALIDATE_SECRET=
